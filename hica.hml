@project {
    name: "bookstore"
    version: "0.1.0"
    license: "MIT"
    entry: "src/main.hc"
}

@dependencies {
    sqlite: "latest"
    imgui: "latest"
    csv: "latest"
}

@koka {
    flags: "--cclib=sqlite3 --cclinkopts=-L./vendor/imgui/lib --cclinkopts=-L/opt/homebrew/opt/sdl2/lib --cclib=imgui_hica --cclib=SDL2 --cclinkopts=-lc++ --cclinkopts=-framework --cclinkopts=OpenGL"
}

@description {
    summary: "Elsewhere Bookshop Inventory - EBI"
    author: "cladam"
    homepage: "https://elsewhere.io"
    repository: "https://github.com/cladam/bookstore"
}
