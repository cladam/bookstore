                        match hc_row_int(row, 2)
                          Nothing ->
                            0
                          Just(v) ->
                            v
                      gui_text(show(s_val))
                      gui_table_next_column()
                      val c_val : string =
                        match hc_row_str(row, 3)
                          Nothing ->
                            "0.00"
                          Just(s) ->
                            s
                      gui_text((c_val ++ " SEK"))
                      gui_table_next_column()
                      val st_val : string =
                        match hc_row_str(row, 4)
                          Nothing ->
                            "Standard"
                          Just(s) ->
                            s
                      gui_text(st_val)
                    gui_end_table()
          hc_gui_tab("Sleeper Review") fn()
            gui_spacing()
            gui_text("Sleeper Titles (Stock present, but no recent monthly sales detected)")
            gui_separator()
            val sql : string = "SELECT i.title, i.author, i.current_stock, i.first_stocked_date, o.status_override, i.match_key FROM inventory i LEFT JOIN sales_history s ON i.match_key = s.match_key LEFT JOIN overrides o ON i.match_key = o.match_key WHERE i.current_stock > 0 AND s.match_key IS NULL"
            match hc_sqlite_query(db, sql)
              Left(e) ->
                gui_text_colored(("Database error: " ++ e.message), 1.0, 0.3, 0.3, 1.0)
              Right(res) ->
                if (res.row_count == 0) then
                  gui_text("No sleeper titles detected. All active inventory has positive sales!")
                else
                  if gui_begin_table("##sleeper_table", 5, 67) then
                    gui_table_setup_column("Book Title")
                    gui_table_setup_column("Current Stock")
                    gui_table_setup_column("First Stocked")
                    gui_table_setup_column("Current Override Status")
                    gui_table_setup_column("Actions / Update Status")
                    gui_table_headers_row()
                    res.rows.foreach fn(row)
                      gui_table_next_row()
                      gui_table_next_column()
                      val t_val : string =
                        match hc_row_str(row, 0)
                          Nothing ->
                            ""
                          Just(s) ->
                            s
                      gui_text(t_val)
                      gui_table_next_column()
                      val s_val : int =
                        match hc_row_int(row, 2)
                          Nothing ->
                            0
                          Just(v) ->
                            v
                      gui_text(show(s_val))
                      gui_table_next_column()
                      val f_val : string =
                        match hc_row_str(row, 3)
                          Nothing ->
                            "-"
                          Just(s) ->
                            s
                      gui_text(f_val)
                      gui_table_next_column()
                      val curr_override : string =
                        match hc_row_str(row, 4)
                          Nothing ->
                            "None"
                          Just(s) ->
                            s
                      gui_text(curr_override)
                      gui_table_next_column()
                      val mk : string =
                        match hc_row_str(row, 5)
                          Nothing ->
                            ""
                          Just(s) ->
                            s
                      val combo_items : string = "No Action\nMerchandise\nDiscount\nDo Not Reorder\nAlways Reorder"
                      val selected : int = gui_combo(("##action_" ++ mk), combo_items, 0)
                      if (selected > 0) then
                        val new_status : string =
                          match selected
                            1 ->
                              "Merchandise"
                            2 ->
                              "Discount"
                            3 ->
                              "Do Not Reorder"
                            4 ->
                              "Always Reorder"
                            _ ->
                              "None"
                        val always_reorder_flag : string = if (selected == 4) then "1" else "0"
                        val _ : either<sqliteerror, bool> = hc_sqlite_exec_p(db, "INSERT INTO overrides (match_key, status_override, always_reorder) VALUES (?, ?, ?) ON CONFLICT(match_key) DO UPDATE SET status_override=excluded.status_override, always_reorder=excluded.always_reorder", [hc_param(mk), hc_param(new_status), hc_param(always_reorder_flag)])
                        ()
                      else
                        ()
                      ()
                    gui_end_table()
          hc_gui_tab("Settings & Import") fn()
            gui_spacing()
            gui_text("EBI Purchasing & Target Settings:")
            gui_separator()
            monthly_budget := gui_slider_float("Monthly Budget (SEK)", 1000.0, 100000.0, monthly_budget)
            replenishment_pct := gui_slider_float("Replenishment Share (%)", 0.0, 100.0, replenishment_pct)
            discovery_pct := gui_slider_float("Discovery Share (%)", 0.0, 100.0, discovery_pct)
            gui_spacing()
            gui_separator()
            gui_text_colored("CSV Data Import Center (Powered by RFC 4180 Parser)", 0.2, 0.8, 0.4, 1.0)
            gui_spacing()
            gui_text("1. Current Inventory CSV Import")
            gui_text_wrapped("Paste comma-separated rows. Expected Headers: title,author,distributor,section,barcode,retail_price,purchase_cost,current_stock,first_stocked_date")
            csv_input_inventory := gui_input_text("##csv_inv", 2048)
            if gui_button("Process Inventory CSV") then
              if (csv_input_inventory != "") then
                val t : csvtable = hc_csv_parse(csv_input_inventory)
                val processed_count : int = list/length(t.rows)
                t.rows.foreach fn(row)
                  val title : string =
                    match hc_str_at(row, 0)
                      Nothing ->
                        ""
                      Just(s) ->
                        s
                  if (title != "") then
                    val author : string =
                      match hc_str_at(row, 1)
                        Nothing ->
                          ""
                        Just(s) ->
                          s
                    val distributor : string =
                      match hc_str_at(row, 2)
                        Nothing ->
                          ""
                        Just(s) ->
                          s
                    val section : string =
                      match hc_str_at(row, 3)
                        Nothing ->
                          ""
                        Just(s) ->
                          s
                    val barcode : string =
                      match hc_str_at(row, 4)
                        Nothing ->
                          ""
                        Just(s) ->
                          s
                    val retail_price : string =
                      match hc_str_at(row, 5)
                        Nothing ->
                          "0.0"
                        Just(s) ->
                          s
                    val purchase_cost : string =
                      match hc_str_at(row, 6)
                        Nothing ->
                          "0.0"
                        Just(s) ->
                          s
                    val current_stock : string =
                      match hc_str_at(row, 7)
                        Nothing ->
                          "0"
                        Just(s) ->
                          s
                    val first_stocked_date : string =
                      match hc_str_at(row, 8)
                        Nothing ->
                          ""
                        Just(s) ->
                          s
                    val mk : string = hc_normalize_title(title)
                    val stock_val : float64 =
                      match current_stock.parse-float64
                        Nothing ->
                          0.0
                        Just(st) ->
                          match purchase_cost.parse-float64
                            Nothing ->
                              0.0
                            Just(hc_co) ->
                              (st * hc_co)
                    val sql : string = "INSERT INTO inventory (title, author, distributor, section, barcode, retail_price, purchase_cost, current_stock, stock_value, first_stocked_date, match_key) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(match_key) DO UPDATE SET current_stock=excluded.current_stock, stock_value=excluded.stock_value, first_stocked_date=excluded.first_stocked_date"
                    val _ : either<sqliteerror, bool> = hc_sqlite_exec_p(db, sql, [hc_param(title), hc_param(author), hc_param(distributor), hc_param(section), hc_param(barcode), hc_param(retail_price), hc_param(purchase_cost), hc_param(current_stock), hc_param(show(stock_val)), hc_param(first_stocked_date), hc_param(mk)])
                    ()
                  else
                    ()
                csv_status_message := (("Successfully processed " ++ show(processed_count)) ++ " inventory records!")
            gui_spacing()
            gui_text("2. Monthly Sales CSV Append")
            gui_text_wrapped("Paste comma-separated rows. Expected Headers: sales_month,title,net_units,sales_incl_vat")
            csv_input_sales := gui_input_text("##csv_sales", 2048)
            if gui_button("Process Sales CSV") then
              if (csv_input_sales != "") then
                val t : csvtable = hc_csv_parse(csv_input_sales)
                val processed_count : int = list/length(t.rows)
                t.rows.foreach fn(row)
                  val m : string =
                    match hc_str_at(row, 0)
                      Nothing ->
                        ""
                      Just(s) ->
                        s
                  val title : string =
                    match hc_str_at(row, 1)
                      Nothing ->
                        ""
                      Just(s) ->
                        s
                  if ((m != "") && (title != "")) then
                    val net_units : string =
                      match hc_str_at(row, 2)
                        Nothing ->
                          "0"
                        Just(s) ->
                          s
                    val sales_incl_vat : string =
                      match hc_str_at(row, 3)
                        Nothing ->
                          "0.0"
                        Just(s) ->
                          s
                    val mk : string = hc_normalize_title(title)
                    val sql : string = "INSERT INTO sales_history (sales_month, title, net_units, sales_incl_vat, match_key) VALUES (?, ?, ?, ?, ?)"
                    val _ : either<sqliteerror, bool> = hc_sqlite_exec_p(db, sql, [hc_param(m), hc_param(title), hc_param(net_units), hc_param(sales_incl_vat), hc_param(mk)])
                    ()
                  else
                    ()
                csv_status_message := (("Successfully appended " ++ show(processed_count)) ++ " monthly sales records!")
            if (csv_status_message != "") then
              gui_spacing()
              gui_text_colored(csv_status_message, 0.2, 0.9, 0.2, 1.0)
  ()
